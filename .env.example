DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com,.ngrok-free.app,.ngrok.io
# Comma-separated HTTPS origins for admin behind tunnels, e.g. https://xxxx.trycloudflare.com
CSRF_TRUSTED_ORIGINS=

# Single source or failover chain (comma-separated, order = priority)
# Examples: demo | equibase,demo | equibase,racing_api,demo
SCRAPER_SOURCE=equibase,racing_api,demo
SCRAPER_REQUEST_DELAY_SECONDS=1.5
SCRAPER_TIMEOUT_SECONDS=30
NEAR_POST_MTP_THRESHOLD=15

# Optional licensed provider (The Racing API North America add-on)
RACING_API_USERNAME=
RACING_API_PASSWORD=
RACING_API_BASE_URL=https://api.theracingapi.com

# Optional Goalserve horse racing feed
GOALSERVE_API_KEY=
GOALSERVE_BASE_URL=http://www.goalserve.com/getfeed

# Tracks included by default in cron jobs
DEFAULT_TRACK_CODES=GP,CD,SAR,BAQ,AQU,SA,DMR,KEE,OP,PIM,LRL,IND,ELP,FG,TAM,TP,WO

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Integrations / webhooks
INTEGRATIONS_ADMIN_TOKEN=dev-admin-token
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=3

# Telegram VIP channel/group
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_VIP_CHAT_ID=

# Referrals
REFERRAL_SHARE_BASE_URL=https://vip.example.com/r/{code}
REFERRAL_REWARD_REFERRER_CREDITS=10
REFERRAL_REWARD_REFERRER_VIP_DAYS=1
REFERRAL_REWARD_REFEREE_CREDITS=5
REFERRAL_MAX_REWARDS_PER_DAY=20
